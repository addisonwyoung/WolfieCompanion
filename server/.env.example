# Copy to .env only if it does not exist; run from server/:
# npm run dev
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# SERVER ONLY: required for peer pictures and review publishing; never use VITE_.
# Leave blank for a reduced-feature reviewer setup.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY: external moderation for review publishing.
OPENAI_API_KEY=
# Server-only, comma- or newline-separated terms. Keep the actual list in an ignored env file or deployment secret.
COURSE_REVIEW_HARD_BLOCK_TERMS=
PORT=3000
NODE_ENV=development
# Optional absolute storage path; leave commented to use the default JSON file.
# CROWD_REPORTS_PATH=/absolute/path/to/crowd-reports.json
ENABLE_SCHEDULE_PREVIEW=0
# Hosted OCR: apply 202611230001_authenticated_schedule_ocr.sql first.
# Requires the server-only Supabase service key and Google credentials.
ENABLE_AUTHENTICATED_SCHEDULE_PREVIEW=0
SCHEDULE_PREVIEW_ORIGIN=http://localhost:5173
# Optional external credential file; prefer user ADC for local Google Vision.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/credentials.json
# Optional Prisma scaffold, unused by current API; no DB URL needed for build.
# DATABASE_URL=postgresql://USER:YOUR_PASSWORD@HOST:PORT/DATABASE
# For separate Prisma tooling, set PRISMA_ENV_FILE in the invoking shell.
# PRISMA_ENV_FILE=.env.supabase
# DIRECT_URL=postgresql://USER:YOUR_PASSWORD@HOST:PORT/DATABASE
