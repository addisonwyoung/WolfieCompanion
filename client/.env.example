# Copy to .env.local. All VITE_ settings are PUBLIC in the browser bundle.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Optional map background; use an approved public key and map ID.
VITE_MAPTILER_API_KEY=
VITE_MAPTILER_MAP_ID=
# Optional public HTTPS or mailto suggestion destination.
VITE_CAMPUS_FEEDBACK_URL=
